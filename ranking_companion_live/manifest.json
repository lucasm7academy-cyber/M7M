{
  "manifest_version": 3,
  "name": "MoviePy Ranking Companion (Live)",
  "version": "1.0.0",
  "description": "Auxiliar do MoviePy Studio para capturar vídeos do YouTube e adicioná-los diretamente aos rankings em tempo real.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage", "sidePanel", "scripting", "activeTab", "tabs"],
  "host_permissions": ["*://localhost/*", "https://*.youtube.com/*", "https://youtu.be/*"],
  "action": {
    "default_title": "Abrir MoviePy Companion",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["https://*.youtube.com/*", "https://youtu.be/*"],
      "js": ["content/content.js"],
      "css": ["content/content.css"],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["content/inline.js"],
      "matches": ["https://*.youtube.com/*", "https://youtu.be/*"]
    }
  ],
  "background": {
    "service_worker": "background/service-worker.js"
  }
}
